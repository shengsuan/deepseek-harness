# Docker build context excludes for the deepseek-harness monorepo.
# The Dockerfile needs the full pnpm workspace (including vendor/ and
# native/landlock-run/), so this list only drops what the built `dsh` runtime
# never imports: VCS metadata, generated/build output, docs/site sources, and
# unrelated language toolchains.

.git/
.github/
.agents/
docs/
python/

# website/ and examples/ are excluded from the runtime image's own product
# surface, but their sources stay in the build context: tsconfig.host.json's
# typecheck-only project include (website/**/*.ts, examples/*/src/**/*.ts,
# among others) runs as part of `pnpm run build:lib:host`, and would fail on
# a missing include if these directories were dropped before the build.
website/.vitepress/cache/
website/.vitepress/dist/
website/node_modules/

# Build output and caches regenerated by `pnpm run build` inside the image.
node_modules/
**/node_modules/
**/lib/
apps/web/dist/
.dsh-build/
.artifacts/
coverage/
.cache/
.pnpm-store/
*.tsbuildinfo

# Local/dev-only state that must never end up in an image layer.
.env
.env.*
CLAUDE.local.md
.claude/
.vscode/
.idea/
.DS_Store
.storages/
.sessions/
.playwright-mcp/
.worktrees/
worktrees/
docker/
